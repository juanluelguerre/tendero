<?xml version="1.0" encoding="utf-8"?>
<!--
  <clear/> is the point of this file. Without it NuGet inherits the machine-wide
  sources, and a clone on a work laptop tries to restore Tendero's packages from
  a private corporate feed it has no credentials for. Restore must depend on
  nothing but nuget.org, on any machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
