{
  "permissions": {
    "ask": ["Bash(git commit:*)", "Bash(git push:*)", "PowerShell(git commit:*)", "PowerShell(git push:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-shell.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the command against CLAUDE.md's rules"
          }
        ]
      }
    ]
  }
}
