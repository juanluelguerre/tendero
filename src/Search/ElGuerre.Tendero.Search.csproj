<Project Sdk="Microsoft.NET.Sdk">

  <!-- A capability, not a bounded context: it projects other contexts into the
       indexes, which is why it references them and nothing references it. It
       reads Catalog for the product and Inventory for availability — ADR 0007
       widened from "Search reads Catalog" to "Search may reference any context
       it projects; no context may reference Search", which is the invariant it
       was protecting all along. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Qdrant.Client" />
  </ItemGroup>

  <!-- The golden sets and thresholds the gate commits, compiled in for the
       backoffice's search-evaluation panel (P8-11). Referenced where they live
       rather than copied: one golden set, reviewed in one place, scored by the CI
       gate and by the panel alike. -->
  <ItemGroup>
    <EmbeddedResource Include="../../tools/SearchEval/golden/*.json"
                      LogicalName="ElGuerre.Tendero.Search.Evaluation.golden.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tools/SearchEval/eval.thresholds.json"
                      LogicalName="ElGuerre.Tendero.Search.Evaluation.eval.thresholds.json" />
  </ItemGroup>

  <!-- Layer B's outside anchors (ADR 0032) — written by us, before any
       measurement, so there is no third-party taxonomy to license. -->
  <ItemGroup>
    <EmbeddedResource Include="Answers\out-of-scope-anchors.json"
                      LogicalName="ElGuerre.Tendero.Search.Answers.out-of-scope-anchors.json" />
  </ItemGroup>

  <!-- Layer B's calibrated margin, compiled in only once it has been measured
       (ADR 0032). Its absence is what keeps layer B off in every process. -->
  <ItemGroup Condition="Exists('Answers\query-scope.calibration.json')">
    <EmbeddedResource Include="Answers\query-scope.calibration.json"
                      LogicalName="ElGuerre.Tendero.Search.Answers.query-scope.calibration.json" />
  </ItemGroup>

  <!-- The adapters stay internal (an architecture rule), so the tests that drive
       them — in memory, and against a real Qdrant — are named here. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ElGuerre.Tendero.Search.Tests" />
    <InternalsVisibleTo Include="ElGuerre.Tendero.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- Search's files use IQuery/IDomainEventHandler without a `using`: they
       resolve through a global using rather than touching the existing files. -->
  <ItemGroup>
    <Using Include="ElGuerre.Tendero.SharedKernel" />
  </ItemGroup>

</Project>
