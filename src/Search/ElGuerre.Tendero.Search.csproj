<Project Sdk="Microsoft.NET.Sdk">

  <!-- A capability, not a bounded context: it projects Catalog into the indexes,
       which is why it is the only project (alongside persistence) that references
       Catalog. See docs/adr/0007-search-reads-catalog-domain.md. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- Search's files use IQuery/IDomainEventHandler without a `using`: they
       resolve through a global using rather than touching the existing files. -->
  <ItemGroup>
    <Using Include="ElGuerre.Tendero.SharedKernel" />
  </ItemGroup>

</Project>
