<Project Sdk="Microsoft.NET.Sdk">

  <!-- A capability, not a bounded context: it projects other contexts into the
       indexes, which is why it references them and nothing references it. It
       reads Catalog for the product and Inventory for availability — ADR 0007
       widened from "Search reads Catalog" to "Search may reference any context
       it projects; no context may reference Search", which is the invariant it
       was protecting all along. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- Search's files use IQuery/IDomainEventHandler without a `using`: they
       resolve through a global using rather than touching the existing files. -->
  <ItemGroup>
    <Using Include="ElGuerre.Tendero.SharedKernel" />
  </ItemGroup>

</Project>
