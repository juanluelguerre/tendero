<Project Sdk="Microsoft.NET.Sdk">

  <!-- Capacidad, no bounded context: proyecta Catalog a los índices, por eso
       es el único proyecto (junto a la persistencia) que referencia Catalog.
       Ver docs/adr/0007-search-reads-catalog-domain.md. -->
  <PropertyGroup>
    <RootNamespace>Tendero.Search</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Elastic.Clients.Elasticsearch" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/Tendero.Catalog.csproj" />
    <ProjectReference Include="../SharedKernel/Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- Los ficheros de Search usan IQuery/IDomainEventHandler sin `using`:
       se resuelven por global using en lugar de tocar los ficheros existentes. -->
  <ItemGroup>
    <Using Include="Tendero.SharedKernel" />
  </ItemGroup>

</Project>
