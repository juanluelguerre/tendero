<Project Sdk="Microsoft.NET.Sdk">

  <!-- The development adapter for the identity port. The contract is not an
       interface of ours: it is OIDC — a discovery document, JWKS and signed JWTs.
       Keycloak is the other adapter, and switching is changing a URL.

       It is a separate project and not a file inside Api so that it is visibly
       replaceable, and so an architecture rule can forbid anybody depending on it
       from the domain. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.DevIssuer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
