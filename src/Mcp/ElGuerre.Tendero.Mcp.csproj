<Project Sdk="Microsoft.NET.Sdk">

  <!-- A transport, not a bounded context: it owns no state and no handler. Five
       read tools that build a query record, hand it to IQueryDispatcher and map
       the answer, which is why the only project references here are the
       SharedKernel that declares the dispatcher and the contexts whose query
       CONTRACTS it names.

       It is a separate assembly and the same process on purpose. The process is
       shared so tool reuse is free — the container is already built and every
       handler is already registered. The assembly is separate so an architecture
       rule can say what this project may not do, and a rule needs something to
       point at. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- The contexts whose query CONTRACTS the tools name. Referencing the
       assembly is not the same as reaching into it: the architecture rule in
       P9-3 forbids any `*.Domain` namespace here, so what may be touched is the
       query record and the result record and nothing else. FluentValidation is
       here for one reason, and it is the same reason src/Api references it — a
       transport maps a rejected request into whatever its own protocol calls an
       error. -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
    <ProjectReference Include="../Ucp/ElGuerre.Tendero.Ucp.csproj" />
  </ItemGroup>

</Project>
