<Project Sdk="Microsoft.NET.Sdk">

  <!-- The outbound adapter: the only piece that knows EF Core and Postgres.
       The architecture tests check that neither Domain nor the slices reference
       Microsoft.EntityFrameworkCore. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Implements the ports the slices declare: IProductRepository and
         IUnitOfWork (Catalog/ImportProducts) and IProductReader (Search). -->
    <ProjectReference Include="../Accounts/ElGuerre.Tendero.Accounts.csproj" />
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <!-- Pricing declares IPricedItemReader and deliberately cannot implement it:
         it must not reference Catalog. This project already knows both, so the
         bridge lives where every other outbound adapter does. -->
    <ProjectReference Include="../Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

</Project>
