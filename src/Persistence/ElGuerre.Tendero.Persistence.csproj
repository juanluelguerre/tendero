<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adaptador de salida: la única pieza que conoce EF Core y Postgres.
       Los tests de arquitectura comprueban que ni Domain ni los slices
       referencian Microsoft.EntityFrameworkCore. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Implementa los puertos declarados por los slices: IProductRepository e
         IUnitOfWork (Catalog/ImportProducts) e IProductReader (Search). -->
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

</Project>
