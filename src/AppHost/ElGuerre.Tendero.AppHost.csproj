<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <!-- "dotnet run" on this project brings everything up: the infrastructure in
       Docker and both .NET services, with the Aspire dashboard in front. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ElGuerre.Tendero.AppHost</RootNamespace>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>tendero-apphost</UserSecretsId>
    <!-- ASPIRE010 asks for the Aspire CLI bundle. The repo is started with
         "dotnet run" (CLAUDE.md), with no extra tool to install, so it is
         silenced deliberately rather than dragging the dependency in. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.Qdrant" />
    <!-- Not used here: Aspire brings it (through StreamJsonRpc) at 2.5.302, which
         GHSA-qhrr-8q5h-9q3h flags. A direct reference lifts it to the patched
         version; see Directory.Packages.props for when it goes. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Api/ElGuerre.Tendero.Api.csproj" />
    <ProjectReference Include="../Workers/ElGuerre.Tendero.Workers.csproj" />
    <ProjectReference Include="../../tools/TrafficSim/ElGuerre.Tendero.TrafficSim.csproj" />
  </ItemGroup>

</Project>
