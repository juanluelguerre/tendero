<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <!-- "dotnet run" on this project brings everything up: the infrastructure in
       Docker and both .NET services, with the Aspire dashboard in front. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ElGuerre.Tendero.AppHost</RootNamespace>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>tendero-apphost</UserSecretsId>
    <!-- ASPIRE010 asks for the Aspire CLI bundle. The repo is started with
         "dotnet run" (CLAUDE.md), with no extra tool to install, so it is
         silenced deliberately rather than dragging the dependency in. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Api/ElGuerre.Tendero.Api.csproj" />
    <ProjectReference Include="../Workers/ElGuerre.Tendero.Workers.csproj" />
  </ItemGroup>

</Project>
