    {
      "type": "timeseries",
      "title": "Requests per second, by service",
      "id": 20,
      "description": "Rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
