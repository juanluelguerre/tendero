        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio (5xx), by service",
      "id": 21,
      "description": "Errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 38
      },
      "targets": [
        {
          "expr": "(sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) or 0 * sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))) / clamp_min(sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval])), 1e-9)",
          "range": true,
          "legendFormat": "{{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "softMax": 0.05,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency, by service",
      "id": 22,
      "description": "Duration. Each dot is an exemplar: it opens the trace it came from in Tempo, and the trace opens its logs in Loki.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 38
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "range": true,
          "legendFormat": "{{job}}",
          "exemplar": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "SLO burn rate, 99.5% availability",
      "id": 23,
      "description": "How fast the error budget of a 99.5% availability objective is spent over the last hour: 1 spends it in exactly 30 days, 14.4 in two days, the usual paging threshold.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "((sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1h])) or 0 * sum by (job) (rate(http_server_request_duration_seconds_count[1h]))) / clamp_min(sum by (job) (rate(http_server_request_duration_seconds_count[1h])), 1e-9)) / 0.005",
          "range": true,
          "legendFormat": "{{job}}, 1h",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
