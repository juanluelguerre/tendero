          "expr": "(sum(increase(tendero_search_requests_total{mode=\"query\",result=\"empty\"}[$__range])) or vector(0)) / clamp_min(sum(increase(tendero_search_requests_total{mode=\"query\"}[$__range])), 1)",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
