<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shopify, an external system reached only through adapters (invariant 3,
       phase 16): the Admin API client and every adapter of a port Shopify can
       stand behind — the catalogue's source (Catalog.Connectors), the stock's
       source (Inventory.Ports), the customers' (Accounts.Ports), the orders' and
       the gift cards' (Ordering.Ports) and the discounts' (Pricing.Ports). One place to read
       how Tendero talks to Shopify.

       It is not a context: it owns no state and declares no domain. It
       references the ports it implements and never a context's domain, which
       an architecture rule holds. A project of its own because Inventory may
       reference the SharedKernel alone, and an adapter of its port living in
       Catalog would make one context implement another's (P16-8). -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Shopify</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The store's webhook (S3): one Carter module, the package the contexts already use. -->
  <ItemGroup>
    <PackageReference Include="Carter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Accounts/ElGuerre.Tendero.Accounts.csproj" />
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Channels/ElGuerre.Tendero.Channels.csproj" />
    <ProjectReference Include="../Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

</Project>
