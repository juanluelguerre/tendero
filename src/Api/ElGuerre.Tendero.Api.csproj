<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP composition root. It has no logic of its own: it registers ports,
       adapters and slices, and lets Carter mount the endpoints the slices declare. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Api</RootNamespace>
    <UserSecretsId>tendero-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../DevIssuer/ElGuerre.Tendero.DevIssuer.csproj" />
    <ProjectReference Include="../Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../Persistence/ElGuerre.Tendero.Persistence.csproj" />
    <ProjectReference Include="../Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../ServiceDefaults/ElGuerre.Tendero.ServiceDefaults.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

</Project>
