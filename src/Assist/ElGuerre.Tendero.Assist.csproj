<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bounded context Assist (phase 12, ADR 0052): what a model proposes and a
       person decides. It owns ActionProposal, which has a lifecycle, a writer and
       actors of its own — how a context earns its boundary (ADR 0014). It runs
       other contexts' commands only through IProposableCommand and reads them
       only through IReadTool, so it references no other context — only the
       SharedKernel and the model port (AI); an architecture rule holds that.
       Microsoft Agent Framework runs Steward's turn (invariant 9). -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Assist</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Carter" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Agents.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AI/ElGuerre.Tendero.AI.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElGuerre.Tendero.Assist.Tests" />
  </ItemGroup>

</Project>
