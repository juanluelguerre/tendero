<Project Sdk="Microsoft.NET.Sdk">

  <!-- A transport, like src/Mcp, and held to the same two architecture rules:
       no handler of its own, and no `*.Domain` namespace. It owns no state.

       What it owns is the SHAPE of a document somebody else specified, which is
       why this project exists at all rather than the manifest being assembled
       inline in an endpoint: the day the spec's field names move, exactly one
       file changes and the compiler finds the rest. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Ucp</RootNamespace>
  </PropertyGroup>

  <!-- The contexts whose slices the capabilities NAME. A capability class holds
       `typeof(SearchProductsQuery)`, so deleting that slice breaks this project's
       build rather than rotting the manifest quietly — which is the whole reason
       the document is derived instead of written by hand.

       It is the same direction src/Mcp points in, and the same rules apply: no
       handler here, and no `*.Domain` namespace. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- UcpSearchNotices stays internal: it is a translation of the shop's own
       answer into UCP's messages, not a shape any other project should build
       on. Its own tests are the exception, same pattern as Inventory, Pricing
       and Search grant their test projects. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ElGuerre.Tendero.Ucp.Tests" />
  </ItemGroup>

</Project>
