<Project>

  <!-- Defaults shared by every project in the repo. Anything that differs per
       project (packages, output type) belongs in the .csproj, not here. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Root namespace is ElGuerre.Tendero.*, which is exactly the project file
         name; the folders under src/ drop the prefix and stay short (Catalog/,
         Search/). Assembly, namespace and .csproj name are one string now, so
         there is nothing to keep in step. -->
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!-- A switch over an enum names every value and has NO default arm where a
         new value must be a decision rather than a fallthrough (IAuditedResult
         is the first: a new command outcome cannot ship until somebody says
         whether it is a refusal). CS8509 — a NAMED value is missing — stays an
         error and is the point. CS8524 only complains that a number cast into
         the enum is not covered, and satisfying it means a discard arm, which
         would silence CS8509 too and turn the missed decision into a runtime
         exception. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <!-- CLAUDE.md: warnings are errors — enforced in CI, not on the laptop. An
       unused local while you are mid-edit should not break your build, but it
       should not reach main either. GitHub Actions exports $(CI) on its own;
       the explicit property reproduces CI locally without remembering a flag. -->
  <PropertyGroup Condition="'$(CI)' == 'true' Or '$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
