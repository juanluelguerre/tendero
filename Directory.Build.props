<Project>

  <!-- Defaults shared by every project in the repo. Anything that differs per
       project (packages, output type) belongs in the .csproj, not here. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- CLAUDE.md: warnings are errors. The CI/dev command passes -warnaserror;
         these two make the build strict even when it is not passed. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Root namespace is Tendero.*; folder names under src/ drop the prefix. -->
    <RootNamespace>Tendero.$(MSBuildProjectName.Replace('Tendero.',''))</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
