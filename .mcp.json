{
  "mcpServers": {
    "tendero-postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--memory=256m",
        "--cpus=1",
        "-e",
        "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${TENDERO_PG_URL:-postgresql://postgres@localhost:35432/tendero-db}"
      }
    }
  }
}
