                {
                  "type": "text",
                  "id": "Dancv",
                  "name": "Lede",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Clay is the awning, olive the produce crate, stone the counter, ink the chalkboard. Everything else is state. The raw ramps below are never referenced by a component — components use the semantic aliases on the next row, which is the whole reason tokens.css keeps the two apart.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": "$text-sm",
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "c3Wrs",
                  "name": "Notation",
                  "fill": "$text-subtle",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Values are printed without the leading hash. The committed guardrail (frontend/libs/shared/i18n/src/lib/design-mockups.spec.ts) refuses a hexadecimal literal anywhere in this file's node tree — text content included — so a sheet that prints its own values has to spell them this way. Every colour here is a named variable whose value is in design/tokens.css, or is declared in design/mockups/proposals.json with its reason.",
                  "lineHeight": 1.6,
                  "fontFamily": "$font-body",
                  "fontSize": "$text-2xs",
                  "fontWeight": "normal"
                }
              ]
            },
