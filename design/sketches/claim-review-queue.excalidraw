      "index": "b05",
      "roundness": null,
      "seed": 709240769,
      "version": 2,
      "versionNonce": 1184555809,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790930172269,
      "link": null,
      "locked": false,
      "text": "AREA 4 — the product under review. Its claims are seen together, but each one is judged on its own:\napproving a claim writes an attribute on the product and text into the search index, so the effect is per claim.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AREA 4 — the product under review. Its claims are seen together, but each one is judged on its own:\napproving a claim writes an attribute on the product and text into the search index, so the effect is per claim.",
      "autoResize": true,
      "lineHeight": 1.25
    },
