      "link": null,
      "locked": false,
      "text": "A row leaves the queue only when every\nclaim on it has been judged. There is no\nbulk action here either — the queue is a\nway in, not a way to clear work.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A row leaves the queue only when every\nclaim on it has been judged. There is no\nbulk action here either — the queue is a\nway in, not a way to clear work.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t68",
      "type": "text",
      "x": 450,
      "y": 362,
      "width": 620.47705078125,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#6B655F",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
