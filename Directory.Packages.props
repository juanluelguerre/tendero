<Project>

  <!-- Central Package Management: one file to review when the licensing policy
       in CLAUDE.md has to be re-checked. Every entry below was verified for the
       EXACT version pinned here (see docs/adr/0006-dependency-baseline.md).
       Banned forever: MediatR, AutoMapper, MassTransit v9+, FluentAssertions v8+, Moq. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <!-- Carter 10.0.0 — MIT -->
    <PackageVersion Include="Carter" Version="10.0.0" />
    <!-- FluentValidation 12.1.1 — Apache-2.0 (not to be confused with FluentAssertions) -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- Microsoft.Extensions.* 11.0.0-preview.7 — MIT. Sólo el contenedor de DI:
         las abstracciones (Options, Logging, Hosting) vienen en el shared
         framework de .NET 11 y referenciarlas explícitamente es un error NU1510. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103" />
    <!-- Microsoft.AspNetCore.OpenApi 11.0.0-preview.7 — MIT. En el framework, así
         que ni Swashbuckle ni NSwag: el documento generado es la fuente de la
         forma de la API, y de ahí salen los tipos del frontend y, más adelante,
         los esquemas de las capabilities de UCP. Misma banda de preview que el
         SDK; se mueve con él. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-preview.7.26381.103" />
    <!-- JwtBearer 11.0.0-preview.7 — MIT. SÓLO valida tokens. Es la mitad
         cliente de la identidad y no cambia cuando el emisor pase del
         dev-issuer a Keycloak: eso es una cadena de configuración. Aquí no se
         escribe un servidor de autorización (invariante 10). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- EF Core 11.0.0-preview.6 — MIT. Pinned one preview behind the SDK on
         purpose: the Npgsql provider takes an EXACT dependency on the EF version,
         so EF moves when Npgsql moves, not when the SDK does. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <!-- Npgsql provider 11.0.0-preview.6 — PostgreSQL License (OSI-approved, BSD-style) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.6" />
    <!-- EF Core Design 11.0.0-preview.6 — MIT. Entra con la primera migración,
         en la MISMA revisión que el runtime. La herramienta va fijada a la misma
         en .config/dotnet-tools.json: el `dotnet ef` global de la máquina era
         10.0.2 y no sirve contra un runtime 11. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup Label="Search">
    <!-- Elastic.Clients.Elasticsearch 9.5.1 — Apache-2.0 -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- OpenTelemetry 1.18.0 — Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <!-- MIT -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire (AppHost only)">
    <!-- Aspire 13.5.3 — MIT -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <!-- Only what the AppHost declares today. Qdrant, Redis and the Ollama
         CommunityToolkit package return with the phase-3 embeddings worker;
         Elasticsearch is a plain container resource (see ADR 0006). -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <!-- Orquesta los dos Angular junto al backend: un comando levanta todo y la
         URL de la API se inyecta en vez de escribirse a mano. MIT. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 4.0.0 — Apache-2.0. Trae Microsoft.Testing.Platform consigo:
         ni VSTest ni Microsoft.NET.Test.Sdk hacen falta (ver dotnet.config). -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- NetArchTest.Rules 1.3.2 — MIT (declared in the repo, not in the nuspec) -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Microsoft.AspNetCore.Mvc.Testing 11.0.0-preview.7 — MIT. Entra con el
         test de contrato de OpenAPI, que arranca la API de verdad con
         WebApplicationFactory y le pide su documento. No arrastra Docker: ni el
         DbContext ni el cliente de Elasticsearch conectan al construirse, así
         que dos cadenas de conexión falsas bastan para levantarla. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.7.26381.103" />
    <!-- Testcontainers.PostgreSql 4.14.0 — MIT. Postgres de verdad para los
         tests que no significan nada contra un proveedor en memoria: el mapeo
         jsonb, los índices únicos y el drenaje del outbox.
         Respawn NO entra: CLAUDE.md ya pedía verificar su licencia al añadirlo,
         y el repo escribe su propio CQRS justamente porque otros paquetes del
         mismo autor pasaron a licencia comercial. El reset es un TRUNCATE de
         veinte líneas (DatabaseReset), que es menos superficie que la duda. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- CsCheck 4.8.0 — Apache-2.0, verified for this exact version. Enters with
         the promotion combination rules, which is the canonical property-based
         case: totals never negative, stackable sets order-independent, two
         exclusives of a group never co-apply. Three examples cannot say that.
         It comes back for the kit solver in phase 13. -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
  </ItemGroup>

</Project>
