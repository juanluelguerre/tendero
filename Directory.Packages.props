<Project>

  <!-- Central Package Management: one file to review when the licensing policy
       in CLAUDE.md has to be re-checked. Every entry below was verified for the
       EXACT version pinned here (see docs/adr/0006-dependency-baseline.md).
       Banned forever: MediatR, AutoMapper, MassTransit v9+, FluentAssertions v8+, Moq. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Application">
    <!-- Carter 10.0.0 — MIT -->
    <PackageVersion Include="Carter" Version="10.0.0" />
    <!-- FluentValidation 12.1.1 — Apache-2.0 (not to be confused with FluentAssertions) -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- Microsoft.Extensions.* 11.0.0-preview.7 — MIT. The DI container only:
         the abstractions (Options, Logging, Hosting) come in .NET 11's shared
         framework, and referencing them explicitly is an NU1510 error. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103" />
    <!-- Microsoft.AspNetCore.OpenApi 11.0.0-preview.7 — MIT. In the framework, so
         neither Swashbuckle nor NSwag: the generated document is the source of
         the API's shape, and from it come the frontend's types and, later, the
         UCP capability schemas. Same preview band as the SDK; it moves with it. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-preview.7.26381.103" />
    <!-- JwtBearer 11.0.0-preview.7 — MIT. It ONLY validates tokens. It is
         identity's client half and it does not change when the issuer goes from
         the dev-issuer to Keycloak: that is a configuration string. No
         authorization server is written here (invariant 10). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <!-- EF Core 11.0.0-preview.6 — MIT. Pinned one preview behind the SDK on
         purpose: the Npgsql provider takes an EXACT dependency on the EF version,
         so EF moves when Npgsql moves, not when the SDK does. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <!-- Npgsql provider 11.0.0-preview.6 — PostgreSQL License (OSI-approved, BSD-style) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.6" />
    <!-- EF Core Design 11.0.0-preview.6 — MIT. It enters with the first
         migration, at the SAME revision as the runtime. The tool is pinned to the
         same one in .config/dotnet-tools.json: the machine's global `dotnet ef`
         was 10.0.2 and is useless against an 11 runtime. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup Label="Search">
    <!-- Elastic.Clients.Elasticsearch 9.5.1 — Apache-2.0 -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="9.5.1" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- OpenTelemetry 1.18.0 — Apache-2.0 -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <!-- MIT -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire (AppHost only)">
    <!-- Aspire 13.5.3 — MIT -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <!-- Only what the AppHost declares today. Qdrant, Redis and the Ollama
         CommunityToolkit package return with the phase-3 embeddings worker;
         Elasticsearch is a plain container resource (see ADR 0006). -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <!-- Orchestrates both Angular apps alongside the backend: one command brings
         everything up and the API's URL is injected instead of hand-written. MIT. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <!-- Aspire.Hosting.Keycloak 13.5.3-preview.1.26425.3 — MIT, declared in the
         nuspec (`<license type="expression">MIT</license>`), authored by
         Microsoft, from github.com/microsoft/aspire. Its only Aspire dependency
         is `Aspire.Hosting 13.5.3`, which is exactly what the AppHost already
         resolves, so there is no version conflict.

         Both halves of ADR 0006's check, and this one passes where
         `Aspire.Hosting.Elasticsearch` failed: that package declared no licence
         AND pinned a conflicting client, which is why Elasticsearch is a plain
         container resource in the AppHost to this day.

         The version string is the awkward part and it is worth knowing rather
         than discovering: EVERY one of this package's 46 published versions is a
         preview, while `Aspire.Hosting.AppHost` 13.5.3 is not. `dotnet package
         search Aspire.Hosting.Keycloak` therefore returns "No results found",
         which reads exactly like a package that does not exist. -->
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.3-preview.1.26425.3" />
  </ItemGroup>

  <!-- Seed image generation. A TOOL-ONLY group: nothing here enters a shipped
       assembly, and no project outside tools/SeedImages may reference it. -->
  <ItemGroup Label="Seed images (tools only)">
    <!-- Microsoft.ML.OnnxRuntime.DirectML 1.24.4 - MIT, verified in the nuspec's
         LICENSE for this exact version, and its native dependency
         Microsoft.AI.DirectML 1.15.4 is MIT too (checked: that is the one that
         could have bitten).

         DirectML and NOT the CUDA package, and not by preference. The RTX 50
         series is Blackwell, compute capability sm_120, and the official
         onnxruntime-gpu build ships no kernels for it - so the CUDA provider
         either fails to bind or falls back to CPU while reporting nothing.
         DirectML accelerates on any DX12 GPU and knows nothing about CUDA
         architectures. It is slower, and slower beats CPU.

         It is also exactly ONE package: this one carries its own
         onnxruntime.dll, so referencing Microsoft.ML.OnnxRuntime alongside it
         puts two native runtimes in the same output folder. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- SkiaSharp 4.151.2 - MIT. The repository had no image library at all: it
         moves image BYTES around and never decodes a pixel (ADR 0011). This is
         the first thing that needs to, because seed/IMAGES-TODO.md asks for
         1400px WebP at quality 82 with no alpha channel, and SDXL emits a 1024px
         tensor. Resize, flatten onto an opaque canvas, encode. -->
    <PackageVersion Include="SkiaSharp" Version="4.151.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xUnit v3 4.0.0 — Apache-2.0. It brings Microsoft.Testing.Platform with
         it: neither VSTest nor Microsoft.NET.Test.Sdk is needed (see dotnet.config). -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- NetArchTest.Rules 1.3.2 — MIT (declared in the repo, not in the nuspec) -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Microsoft.AspNetCore.Mvc.Testing 11.0.0-preview.7 — MIT. It enters with
         the OpenAPI contract test, which starts the API for real with
         WebApplicationFactory and asks it for its document. It drags in no
         Docker: neither the DbContext nor the Elasticsearch client connects on
         construction, so two fake connection strings are enough to boot it. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-preview.7.26381.103" />
    <!-- Testcontainers.PostgreSql 4.14.0 — MIT. A real Postgres for the tests
         that mean nothing against an in-memory provider: the jsonb mapping, the
         unique indexes and the outbox drain.
         Respawn does NOT enter: CLAUDE.md already asked for its licence to be
         verified on adding it, and this repo writes its own CQRS precisely
         because other packages by the same author moved to a commercial licence.
         The reset is a twenty-line TRUNCATE of our own, which is less surface
         than the doubt. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- CsCheck 4.8.0 — Apache-2.0, verified for this exact version. Enters with
         the promotion combination rules, which is the canonical property-based
         case: totals never negative, stackable sets order-independent, two
         exclusives of a group never co-apply. Three examples cannot say that.
         It comes back for the kit solver in phase 13. -->
    <PackageVersion Include="CsCheck" Version="4.8.0" />
  </ItemGroup>

</Project>
