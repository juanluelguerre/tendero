{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@tendero/shared-a11y": ["./libs/shared/a11y/src/index.ts"],
      "@tendero/shared-agent": ["./libs/shared/agent/src/index.ts"],
      "@tendero/shared-api": ["./libs/shared/api/src/index.ts"],
      "@tendero/shared-auth": ["./libs/shared/auth/src/index.ts"],
      "@tendero/shared-i18n": ["./libs/shared/i18n/src/index.ts"],
      "@tendero/shared-composer": ["./libs/shared/composer/src/index.ts"],
      "@tendero/shared-composer/testing": ["./libs/shared/composer/src/testing.ts"],
      "@tendero/shared-telemetry": ["./libs/shared/telemetry/src/index.ts"],
      "@tendero/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@tendero/shared-util": ["./libs/shared/util/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
