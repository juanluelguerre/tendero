{
  "singleQuote": true,
  "printWidth": 120,
  "endOfLine": "lf",
  "trailingComma": "all",
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./libs/shared/tokens/src/theme.css",
  "overrides": [{ "files": "*.html", "options": { "parser": "angular" } }]
}
