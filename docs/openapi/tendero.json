{
  "openapi": "3.2.0",
  "info": {
    "title": "ElGuerre.Tendero.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "paths": {
    "/api/catalog/products/{id}/publish": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "operationId": "PublishProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishProductResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishProductConflict"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "ListProducts",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProductsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/import": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "operationId": "ImportProducts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportProductsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportProductsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/{id}": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "operationId": "GetProductImage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/catalog/products/{id}/variants": {
      "post": {
        "tags": [
          "Catalog"
        ],
        "operationId": "DefineVariants",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DefineVariantsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DefineVariantsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "SearchProducts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResultPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/reindex": {
      "post": {
        "tags": [
          "Search"
        ],
        "operationId": "ReindexProducts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReindexProductsResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DefineVariantsRequest": {
        "required": [
          "axes",
          "skuPrefix"
        ],
        "type": "object",
        "properties": {
          "axes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VariantAxisRequest"
            }
          },
          "skuPrefix": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DefineVariantsResponse": {
        "required": [
          "created",
          "existing"
        ],
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "format": "int32"
          },
          "existing": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ImportProductsCommand": {
        "required": [
          "source"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          }
        }
      },
      "ImportProductsResult": {
        "required": [
          "created",
          "updated",
          "failed",
          "elapsedSeconds"
        ],
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "format": "int32"
          },
          "updated": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          },
          "elapsedSeconds": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ListProductsResult": {
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProductSummary": {
        "required": [
          "productId",
          "name",
          "slug",
          "brand",
          "category",
          "priceAmount",
          "priceCurrency",
          "imageId",
          "status",
          "missingCultures",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "priceAmount": {
            "type": "number",
            "format": "double"
          },
          "priceCurrency": {
            "type": "string"
          },
          "imageId": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": "string"
          },
          "missingCultures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublishProductConflict": {
        "required": [
          "title",
          "detail"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "PublishProductResponse": {
        "required": [
          "productId",
          "outcome",
          "status"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ReindexProductsResult": {
        "required": [
          "indexed",
          "removed",
          "elapsedSeconds"
        ],
        "type": "object",
        "properties": {
          "indexed": {
            "type": "integer",
            "format": "int32"
          },
          "removed": {
            "type": "integer",
            "format": "int32"
          },
          "elapsedSeconds": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SearchHit": {
        "required": [
          "productId",
          "name",
          "slug",
          "brand",
          "category",
          "matchedVariantId",
          "matchedSku",
          "priceAmount",
          "priceFrom",
          "priceTo",
          "priceCurrency",
          "imageId",
          "score"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "brand": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "type": [
              "null",
              "string"
            ]
          },
          "matchedVariantId": {
            "type": "string"
          },
          "matchedSku": {
            "type": "string"
          },
          "priceAmount": {
            "type": "number",
            "format": "double"
          },
          "priceFrom": {
            "type": "number",
            "format": "double"
          },
          "priceTo": {
            "type": "number",
            "format": "double"
          },
          "priceCurrency": {
            "type": "string"
          },
          "imageId": {
            "type": [
              "null",
              "string"
            ]
          },
          "score": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SearchResultPage": {
        "required": [
          "hits",
          "total",
          "page",
          "pageSize",
          "tookMs"
        ],
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "tookMs": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "VariantAxisRequest": {
        "required": [
          "code",
          "options"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Catalog"
    },
    {
      "name": "Search"
    }
  ]
}
