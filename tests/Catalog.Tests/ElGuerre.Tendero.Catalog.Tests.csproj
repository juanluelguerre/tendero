<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Catalog.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Catalog/ElGuerre.Tendero.Catalog.csproj" />
  </ItemGroup>

  <!-- The contract suite runs against the SAME sample the repository ships: if
       the seed file stops honouring the contract, it is known here. -->
  <ItemGroup>
    <Content Include="../../seed/products.sample.json" Link="TestData/products.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The fixed clock shared by the test projects (../TestClock.cs). -->
  <ItemGroup>
    <Compile Include="../TestClock.cs" Link="TestClock.cs" />
  </ItemGroup>

</Project>
