[
  {
    "when": "English",
    "calls": [
      {
        "tool": "look_at_gaps",
        "arguments": {}
      },
      {
        "tool": "propose_set_value",
        "arguments": {
          "items": [
            {
              "subject": "MUG-1",
              "value": "Mug",
              "reason": "It has no English name."
            }
          ]
        }
      }
    ],
    "say": "I read the gaps and proposed: {tool:propose_set_value}",
    "inputTokens": 1500,
    "outputTokens": 120
  },
  {
    "when": "loop",
    "calls": [
      {
        "tool": "look_at_gaps",
        "arguments": {}
      }
    ],
    "always": true
  },
  {
    "when": "invent",
    "calls": [
      {
        "tool": "no_such_tool",
        "arguments": {}
      }
    ],
    "say": "That tool does not exist."
  },
  {
    "when": "drop",
    "calls": [
      {
        "tool": "propose_set_value",
        "arguments": {
          "items": [
            {
              "subject": "MUG-1",
              "value": "Mug",
              "reason": "Because."
            }
          ]
        }
      }
    ],
    "thenFail": true
  },
  {
    "when": "picky",
    "calls": [
      {
        "tool": "picky",
        "arguments": {}
      }
    ],
    "always": true
  },
  {
    "when": "slow",
    "say": "Late.",
    "delayMs": 3000
  },
  {
    "when": "wrong arguments",
    "calls": [
      {
        "tool": "picky",
        "arguments": {
          "kind": "Everything"
        }
      }
    ],
    "say": "I asked again: {tool:picky}"
  },
  {
    "when": "leak",
    "calls": [
      {
        "tool": "leaky",
        "arguments": {}
      }
    ],
    "say": "The tool said: {tool:leaky}"
  },
  {
    "when": "tool call as text",
    "say": "<tool_call>{\"name\": \"find_products\", \"arguments\": {\"text\": \"mug\"}}</tool_call>"
  },
  {
    "when": "numeric reason",
    "calls": [
      {
        "tool": "propose_set_value",
        "arguments": {
          "items": [
            {
              "subject": "MUG-1",
              "value": "Mug",
              "reason": 5
            }
          ]
        }
      }
    ],
    "say": "The tool said: {tool:propose_set_value}"
  },
  {
    "when": "copy the shelf",
    "calls": [
      {
        "tool": "look_at_shelf",
        "arguments": {}
      }
    ],
    "say": "Five things are on the shelf.\n\n- MUG-1\n- CUP-2\n- PAN-3\n- BAG-4\n- LAMP-5"
  },
  {
    "when": "only the shelf",
    "calls": [
      {
        "tool": "look_at_shelf",
        "arguments": {}
      }
    ],
    "say": "- MUG-1\n- CUP-2\n- PAN-3\n- BAG-4\n- LAMP-5"
  },
  {
    "when": "hello",
    "say": "Hello."
  }
]
