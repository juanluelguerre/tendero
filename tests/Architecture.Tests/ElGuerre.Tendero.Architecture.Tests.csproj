<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules from docs/testing.md, executable. When one blocks you, the
       answer is a design conversation (perhaps an ADR), never relaxing it. -->
  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Architecture.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Api and Workers both expose a top-level `Program` in the global
         namespace; the alias avoids the ambiguity without touching either. -->
    <ProjectReference Include="../../src/Api/ElGuerre.Tendero.Api.csproj" Aliases="TenderoApi" />
    <ProjectReference Include="../../src/Accounts/ElGuerre.Tendero.Accounts.csproj" />
    <ProjectReference Include="../../src/Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../../src/Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../../src/Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../../src/Persistence/ElGuerre.Tendero.Persistence.csproj" />
    <ProjectReference Include="../../src/Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../../src/Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../../src/ServiceDefaults/ElGuerre.Tendero.ServiceDefaults.csproj" />
    <ProjectReference Include="../../src/SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
    <ProjectReference Include="../../src/Workers/ElGuerre.Tendero.Workers.csproj" />
    <!-- The evaluation tool is subject to the rules: a tool is exactly where
         somebody would shortcut to the Elastic client past the ports. -->
    <ProjectReference Include="../../tools/SearchEval/ElGuerre.Tendero.SearchEval.csproj" />
  </ItemGroup>

</Project>
