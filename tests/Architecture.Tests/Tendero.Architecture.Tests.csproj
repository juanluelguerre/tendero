<Project Sdk="Microsoft.NET.Sdk">

  <!-- Las reglas de docs/testing.md, ejecutables. Cuando una bloquea, la
       respuesta es una conversación de diseño (quizá un ADR), nunca relajarla. -->
  <PropertyGroup>
    <RootNamespace>Tendero.Architecture.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Api y Workers exponen ambos un `Program` de nivel superior en el
         namespace global; el alias evita la ambigüedad sin tocar ninguno. -->
    <ProjectReference Include="../../src/Api/Tendero.Api.csproj" Aliases="TenderoApi" />
    <ProjectReference Include="../../src/Catalog/Tendero.Catalog.csproj" />
    <ProjectReference Include="../../src/Ordering/Tendero.Ordering.csproj" />
    <ProjectReference Include="../../src/Persistence/Tendero.Persistence.csproj" />
    <ProjectReference Include="../../src/Search/Tendero.Search.csproj" />
    <ProjectReference Include="../../src/ServiceDefaults/Tendero.ServiceDefaults.csproj" />
    <ProjectReference Include="../../src/SharedKernel/Tendero.SharedKernel.csproj" />
    <ProjectReference Include="../../src/Workers/Tendero.Workers.csproj" />
    <!-- La herramienta de evaluación entra en las reglas: un tool es justo donde
         alguien atajaría hasta el cliente de Elastic saltándose los puertos. -->
    <ProjectReference Include="../../tools/SearchEval/Tendero.SearchEval.csproj" />
  </ItemGroup>

</Project>
