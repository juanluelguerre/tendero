<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Search.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Search/ElGuerre.Tendero.Search.csproj" />
  </ItemGroup>

  <!-- The fixed clock shared by the test projects (../TestClock.cs). -->
  <ItemGroup>
    <Compile Include="../TestClock.cs" Link="TestClock.cs" />
    <Compile Include="../InstrumentRecorder.cs" Link="InstrumentRecorder.cs" />
  </ItemGroup>

  <!-- What the maker's own tokenizer gives for the texts SigLIP 2's is held to
       (phase 13a, P13-1): written by src/AppHost/scripts/siglip-tokenizer-fixture.py,
       committed, and read by the test beside it. -->
  <ItemGroup>
    <Content Include="Images/siglip-tokenizer-fixture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
