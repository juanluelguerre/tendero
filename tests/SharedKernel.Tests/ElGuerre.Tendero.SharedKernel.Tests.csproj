<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.SharedKernel.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

  <!-- The fixed clock shared by the test projects (../TestClock.cs). The audit
       step stamps an entry, and a test that could not pin the instant would be
       asserting the wall clock. -->
  <ItemGroup>
    <Compile Include="../TestClock.cs" Link="TestClock.cs" />
  </ItemGroup>

</Project>
