<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Sdk.Web and not plain Sdk: WebApplicationFactory needs ASP.NET Core's
       framework reference to start the API inside the process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ElGuerre.Tendero.Api.Tests</RootNamespace>
    <!-- The Web SDK generates a launchSettings.json with a random port and
         launchBrowser. Nothing is launched here: WebApplicationFactory brings the
         API up inside the process. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Api/ElGuerre.Tendero.Api.csproj" />
  </ItemGroup>


  <!-- The UCP schemas and the loader that resolves them, shared from
       tests/Ucp.Tests rather than copied: one vendored set, one pinned commit,
       one place to update. -->
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Ucp.Tests/UcpSchemas.cs" Link="UcpSchemas.cs" />
    <Content Include="../Ucp.Tests/ucp-schemas/**/*.json" LinkBase="ucp-schemas">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
