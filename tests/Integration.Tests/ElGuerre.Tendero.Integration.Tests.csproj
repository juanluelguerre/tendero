<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ElGuerre.Tendero.Integration.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../../src/Inventory/ElGuerre.Tendero.Inventory.csproj" />
    <ProjectReference Include="../../src/Ordering/ElGuerre.Tendero.Ordering.csproj" />
    <ProjectReference Include="../../src/Persistence/ElGuerre.Tendero.Persistence.csproj" />
    <ProjectReference Include="../../src/Pricing/ElGuerre.Tendero.Pricing.csproj" />
    <ProjectReference Include="../../src/Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../../src/SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
    <ProjectReference Include="../../src/Workers/ElGuerre.Tendero.Workers.csproj" />
  </ItemGroup>

  <!-- The import and the saga run against the SAME samples the repository
       ships, exactly as the connector's contract suite does: a test that
       invented its own warehouses would not be testing the shop's preference
       order. -->
  <ItemGroup>
    <Content Include="../../seed/products.sample.json" Link="TestData/products.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../seed/warehouses.sample.json" Link="TestData/warehouses.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../seed/attributes.sample.json" Link="TestData/attributes.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../seed/categories.sample.json" Link="TestData/categories.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../seed/pricelists.sample.json" Link="TestData/pricelists.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../seed/promotions.sample.json" Link="TestData/promotions.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The fixed clock shared by the test projects (../TestClock.cs). -->
  <ItemGroup>
    <Compile Include="../TestClock.cs" Link="TestClock.cs" />
    <Compile Include="../OrderBuilder.cs" Link="OrderBuilder.cs" />
  </ItemGroup>

</Project>
