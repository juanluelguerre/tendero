<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tool, not a layer: it leans on Search's ports and on the catalogue
       connector, and knows neither Elasticsearch nor EF Core. Architecture rule
       4 watches it like the rest of the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ElGuerre.Tendero.SearchEval</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Catalog/ElGuerre.Tendero.Catalog.csproj" />
    <ProjectReference Include="../../src/Search/ElGuerre.Tendero.Search.csproj" />
    <ProjectReference Include="../../src/SharedKernel/ElGuerre.Tendero.SharedKernel.csproj" />
  </ItemGroup>

</Project>
